rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Public catalog collections: readable and writable by panel
    match /categories/{categoryId} {
      allow read, write: if true;
    }

    match /services/{serviceId} {
      allow read, write: if true;
    }

    match /plans/{planId} {
      allow read, write: if true;
    }

    match /offers/{offerId} {
      allow read, write: if true;
    }

    match /banners/{bannerId} {
      allow read, write: if true;
    }

    match /settings/{settingId} {
      allow read, write: if true;
    }

    // Orders collection: creation, read, and admin updates
    match /orders/{orderId} {
      allow read, write: if true;
    }

    // Support tickets
    match /supportTickets/{ticketId} {
      allow read, write: if true;
    }

    // Partner & Referral Program collections
    match /partners/{partnerId} {
      allow read, write: if true;
    }

    match /partner_commissions/{commissionId} {
      allow read, write: if true;
    }

    match /payout_requests/{payoutId} {
      allow read, write: if true;
    }

    match /partner_tickets/{ticketId} {
      allow read, write: if true;
    }
  }
}

